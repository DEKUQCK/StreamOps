# Discord Developer Portal -> your application -> Bot -> Reset Token
DISCORD_BOT_TOKEN=

# Same values the Next.js app uses (see ../.env.example) - the bot only
# ever calls the two bot_* RPCs, never a service_role key.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Shared secret checked inside bot_get_pending_reminders / bot_mark_reminder_sent.
# Ask whoever set up the database for this value - it is not stored in git.
BOT_SECRET=

# Base URL of the deployed StreamOps app, used to build the login/"my
# events" link in each reminder message.
APP_BASE_URL=http://localhost:3000

# How often to check for due reminders.
POLL_INTERVAL_MINUTES=15
